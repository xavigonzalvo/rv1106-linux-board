{"text": "<meta name=\"dash-one-writer\">\n<style>\n  /* Layout: one centered column; \"now + board\" pair, phase stepper, then activity | findings, then test points. */\n  .bp { --bp-max: 76rem; max-width: var(--bp-max); margin-inline: auto; display: grid; gap: var(--cds-gap-lg); font-family: var(--font-anthropic-sans); }\n  .bp * { box-sizing: border-box; }\n  .bp :is(p, li, dd, span, summary, div) { overflow-wrap: anywhere; }\n  .bp-head { display: grid; gap: var(--cds-gap-xs); }\n  .bp-head h1 { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n  .bp-head p { margin: 0; color: var(--color-fg-muted); font-size: var(--cds-font-size-body); }\n  .bp-head b { color: var(--color-fg); font-weight: 500; }\n\n  .bp-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); min-width: 0; display: grid; gap: var(--cds-gap-sm); align-content: start; }\n  .bp-card > h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }\n  .bp-note { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); margin: 0; max-width: 65ch; }\n  .bp-row { display: grid; gap: var(--cds-gap-md); grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); align-items: start; }\n  .bp-row > * { min-width: 0; }\n\n  /* Pills */\n  .bp-pill { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; font-size: var(--cds-font-size-caption); }\n  .bp-pill::before { content: \"\"; width: 8px; height: 8px; border-radius: 50%; background: var(--color-border-line); flex: none; }\n  .bp-pill.in_progress::before { background: var(--cds-chart-reference); }\n  .bp-pill.in_review::before { background: var(--color-warn); }\n  .bp-pill.needs_fix::before, .bp-pill.failed::before, .bp-pill.open::before { background: var(--color-bad); }\n  .bp-pill.verified::before, .bp-pill.in_schematic::before, .bp-pill.measured_ok::before, .bp-pill.fixed::before { background: var(--color-ok); }\n  .bp-pill.carried::before { background: var(--color-warn); }\n\n  /* Now panel */\n  .bp-now { border-top: 3px solid var(--cds-chart-reference); }\n  .bp-now-top { display: flex; align-items: center; justify-content: space-between; gap: var(--cds-gap-sm); flex-wrap: wrap; }\n  .bp-eyebrow { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); letter-spacing: .05em; text-transform: uppercase; }\n  .bp-now-title { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); line-height: 1.2; margin: 0; text-wrap: balance; }\n  .bp-now-goal { margin: 0; }\n  .bp-facts { display: grid; gap: var(--cds-gap-xs); margin: 0; font-size: var(--cds-font-size-caption); }\n  .bp-facts > div { display: grid; grid-template-columns: 6.5rem 1fr; gap: var(--cds-gap-sm); }\n  .bp-facts dt { color: var(--color-fg-muted); }\n  .bp-facts dd { margin: 0; min-width: 0; }\n  .bp-sub { font-size: var(--cds-font-size-caption); font-weight: var(--cds-font-weight-medium); color: var(--color-fg-muted); margin: var(--cds-gap-sm) 0 0; }\n\n  /* Board drawing */\n  .bp-board { position: relative; min-height: 220px; }\n  .bp-board svg { display: block; width: 100%; height: auto; }\n  .bp-pcb { fill: color-mix(in srgb, var(--color-ok) 8%, var(--color-bg)); stroke: var(--color-border-line); stroke-width: 2; }\n  .bp-hole { fill: var(--color-bg); stroke: var(--color-border-line); }\n  .bp-trace { stroke: var(--cds-chart-grid); stroke-width: 3; fill: none; stroke-linecap: round; }\n  .bp-blk rect { stroke-width: 1.5; }\n  .bp-blk text { fill: var(--color-fg); font-family: var(--font-anthropic-sans); }\n  .bp-blk .bp-bsub { fill: var(--color-fg-muted); font-size: 10px; }\n  .st-not_started rect { fill: var(--color-panel); stroke: var(--color-border-line); stroke-dasharray: 4 3; }\n  .st-in_progress rect { fill: color-mix(in srgb, var(--cds-chart-reference) 18%, var(--color-panel)); stroke: var(--cds-chart-reference); }\n  .st-in_review rect { fill: color-mix(in srgb, var(--color-warn) 18%, var(--color-panel)); stroke: var(--color-warn); }\n  .st-needs_fix rect { fill: color-mix(in srgb, var(--color-bad) 18%, var(--color-panel)); stroke: var(--color-bad); }\n  .st-verified rect { fill: color-mix(in srgb, var(--color-ok) 22%, var(--color-panel)); stroke: var(--color-ok); }\n  .bp-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-xs) var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .bp-legend span { display: inline-flex; align-items: center; gap: var(--cds-gap-xs); }\n  .bp-sw { width: 12px; height: 12px; border-radius: 3px; border: 1.5px solid; display: inline-block; }\n  .bp-sw.not_started { border-color: var(--color-border-line); border-style: dashed; }\n  .bp-sw.in_progress { border-color: var(--cds-chart-reference); background: color-mix(in srgb, var(--cds-chart-reference) 18%, transparent); }\n  .bp-sw.in_review { border-color: var(--color-warn); background: color-mix(in srgb, var(--color-warn) 18%, transparent); }\n  .bp-sw.needs_fix { border-color: var(--color-bad); background: color-mix(in srgb, var(--color-bad) 18%, transparent); }\n  .bp-sw.verified { border-color: var(--color-ok); background: color-mix(in srgb, var(--color-ok) 22%, transparent); }\n  .bp-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); max-width: min(18rem, 90%); z-index: 2; }\n  .bp-tip .bp-tip-k { color: var(--cds-text-secondary); }\n\n  /* Phase stepper */\n  .bp-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--cds-gap-sm); grid-template-columns: repeat(auto-fill, minmax(min(100%, 8.5rem), 1fr)); }\n  .bp-step { display: grid; gap: 4px; align-content: start; padding: var(--cds-pad-sm); border-radius: var(--cds-radius); border: 1px solid var(--color-border-line); background: var(--color-bg); min-width: 0; }\n  .bp-step.current { border-color: var(--cds-chart-reference); box-shadow: inset 0 3px 0 var(--cds-chart-reference); }\n  .bp-step.verified { box-shadow: inset 0 3px 0 var(--color-ok); }\n  .bp-step.needs_fix { box-shadow: inset 0 3px 0 var(--color-bad); }\n  .bp-step-n { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); font-variant-numeric: tabular-nums; }\n  .bp-step-name { font-weight: 500; font-size: var(--cds-font-size-caption); line-height: 1.3; }\n  .bp-step-meta { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n\n  /* Activity feed + findings list */\n  .bp-feed { list-style: none; margin: 0; padding: 0; display: grid; }\n  .bp-feed > li { display: grid; grid-template-columns: 5.5rem 1fr; gap: var(--cds-gap-sm); padding: var(--cds-pad-sm) 0; border-top: 1px solid var(--color-border-line); font-size: var(--cds-font-size-caption); }\n  .bp-feed > li:first-child { border-top: 0; }\n  .bp-when { color: var(--color-fg-muted); font-variant-numeric: tabular-nums; line-height: 1.35; }\n  .bp-what { min-width: 0; display: grid; gap: 2px; }\n  .bp-ev { font-weight: 500; }\n  .bp-ev .bp-who { color: var(--color-fg-muted); font-weight: 400; }\n  .bp-ev.passed { color: var(--color-ok); } .bp-ev.rejected { color: var(--color-bad); }\n  .bp-clamp { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; color: var(--color-fg-muted); }\n  .bp-scrollbox { max-height: 34rem; overflow-y: auto; overscroll-behavior: contain; padding-right: 4px; }\n\n  .bp-chips { display: flex; flex-wrap: wrap; gap: var(--cds-gap-xs); }\n  .bp-chip { font: inherit; font-size: var(--cds-font-size-caption); padding: 4px 10px; border-radius: 999px; border: 1px solid var(--color-border-line); background: var(--color-bg); color: var(--color-fg); cursor: pointer; display: inline-flex; gap: 6px; align-items: center; }\n  .bp-chip[aria-pressed=\"true\"] { border-color: var(--color-fg); background: var(--color-fg); color: var(--color-bg); }\n  .bp-chip:focus-visible, .bp-more:focus-visible, .bp-find summary:focus-visible { outline: 2px solid var(--cds-chart-reference); outline-offset: 2px; }\n  .bp-chip b { font-weight: 500; font-variant-numeric: tabular-nums; }\n\n  .bp-flist { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--cds-gap-xs); }\n  .bp-find { border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); background: var(--color-bg); font-size: var(--cds-font-size-caption); }\n  .bp-find summary { list-style: none; cursor: pointer; padding: var(--cds-pad-sm); display: grid; gap: 4px; }\n  .bp-find summary::-webkit-details-marker { display: none; }\n  .bp-find-top { display: flex; flex-wrap: wrap; gap: 4px var(--cds-gap-sm); align-items: center; }\n  .bp-sev { font-weight: 500; text-transform: capitalize; }\n  .bp-sev.blocker, .bp-sev.major { color: var(--color-bad); }\n  .bp-sev.minor { color: var(--color-warn); }\n  .bp-tag { color: var(--color-fg-muted); font-variant-numeric: tabular-nums; }\n  .bp-find[open] .bp-clamp { -webkit-line-clamp: unset; display: block; color: var(--color-fg); }\n  .bp-find-fix { padding: 0 var(--cds-pad-sm) var(--cds-pad-sm); display: grid; gap: 2px; }\n  .bp-find-fix b { font-weight: 500; }\n  .bp-empty { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin: 0; }\n  .bp-more { font: inherit; font-size: var(--cds-font-size-caption); justify-self: start; background: none; border: 0; padding: 0; color: var(--cds-chart-reference); cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }\n\n  /* Test points */\n  .bp-scroll { overflow-x: auto; }\n  .bp-table { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n  .bp-table th { text-align: left; color: var(--color-fg-muted); font-weight: var(--cds-font-weight-medium); padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n  .bp-table td { padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); vertical-align: top; }\n  .bp-table td:first-child, .bp-table td:nth-child(2) { white-space: nowrap; }\n\n  [data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n  @media (max-width: 30rem) { .bp-feed > li { grid-template-columns: 1fr; gap: 2px; } .bp-facts > div { grid-template-columns: 1fr; gap: 0; } }\n</style>\n\n<div class=\"bp\">\n  <header class=\"bp-head\">\n    <h1>RV1106 Linux board, Rev A</h1>\n    <p><b data-draw=\"verified\" data-source=\"progress\" data-field=\"verified\">\u2014</b> of <b data-draw=\"total\" data-source=\"progress\" data-field=\"total\">\u2014</b> design gates passed. Now on <b data-draw=\"current\" data-source=\"progress\" data-field=\"current\">\u2014</b>.</p>\n  </header>\n\n  <div class=\"bp-row\">\n    <section class=\"bp-card bp-now\" id=\"now\">\n      <div class=\"bp-now-top\">\n        <span class=\"bp-eyebrow\">Current phase</span>\n        <span class=\"bp-pill\" data-draw=\"nowstep\" data-source=\"now\" data-field=\"step\">\u2014</span>\n      </div>\n      <h2 class=\"bp-now-title\" data-draw=\"nowname\" data-source=\"now\" data-field=\"title\">\u2014</h2>\n      <p class=\"bp-now-goal\" data-draw=\"nowgoal\" data-source=\"now\" data-field=\"goal\">\u2014</p>\n      <dl class=\"bp-facts\">\n        <div><dt>Produces</dt><dd data-draw=\"nowout\" data-source=\"now\" data-field=\"outputs\">\u2014</dd></div>\n        <div><dt>Passes when</dt><dd data-draw=\"nowgate\" data-source=\"now\" data-field=\"gate_text\">\u2014</dd></div>\n        <div><dt>Round</dt><dd><span data-draw=\"nowround\" data-source=\"now\" data-field=\"rounds\">\u2014</span> of 3 allowed</dd></div>\n      </dl>\n      <h3 class=\"bp-sub\">Latest in this phase</h3>\n      <ol class=\"bp-feed\" data-draw=\"nowfeed\" data-source=\"activity\"></ol>\n      <h3 class=\"bp-sub\">Open findings in this phase</h3>\n      <ul class=\"bp-flist\" data-draw=\"nowfind\" data-source=\"findings\"></ul>\n      <p class=\"bp-empty bp-nofind\" hidden>None open. The verifier hasn't rejected anything in this phase.</p>\n    </section>\n\n    <section class=\"bp-card\" id=\"board\">\n      <h2>Board</h2>\n      <p class=\"bp-note\">Each PCB block, colored by where its design stands. Hover or focus a block for its latest note.</p>\n      <div class=\"bp-board\" data-draw=\"board\" data-source=\"blocks\">\u2014</div>\n      <div class=\"bp-legend\">\n        <span><i class=\"bp-sw not_started\"></i>Not started</span>\n        <span><i class=\"bp-sw in_progress\"></i>Executor working</span>\n        <span><i class=\"bp-sw in_review\"></i>Verifier reviewing</span>\n        <span><i class=\"bp-sw needs_fix\"></i>Needs fix</span>\n        <span><i class=\"bp-sw verified\"></i>Verified</span>\n      </div>\n    </section>\n  </div>\n\n  <section class=\"bp-card\" id=\"phases\">\n    <h2>Design gates</h2>\n    <p class=\"bp-note\">Each phase passes only when the verifier signs off its gate. Up to 3 executor/verifier rounds per phase.</p>\n    <ol class=\"bp-steps\" data-draw=\"steps\" data-source=\"phases\"></ol>\n  </section>\n\n  <div class=\"bp-row\">\n    <section class=\"bp-card\" id=\"activity\">\n      <h2>Activity</h2>\n      <p class=\"bp-note\">Every executor and verifier step, newest first.</p>\n      <div class=\"bp-scrollbox\">\n        <ol class=\"bp-feed\" data-draw=\"actlist\" data-source=\"activity\"></ol>\n      </div>\n    </section>\n\n    <section class=\"bp-card\" id=\"findings\">\n      <h2>Verifier findings</h2>\n      <p class=\"bp-note\">Open: the executor is fixing it now. Carried: a minor item handed to a later phase. Fixed: resolved and confirmed by the next review. Open a finding to read the full text and the fix.</p>\n      <div class=\"bp-chips\" role=\"group\" aria-label=\"Filter findings\">\n        <button type=\"button\" class=\"bp-chip\" data-filter=\"open\" aria-pressed=\"false\">Open <b data-draw=\"cnt-open\" data-source=\"findings\">\u2014</b></button>\n        <button type=\"button\" class=\"bp-chip\" data-filter=\"carried\" aria-pressed=\"false\">Carried <b data-draw=\"cnt-carried\" data-source=\"findings\">\u2014</b></button>\n        <button type=\"button\" class=\"bp-chip\" data-filter=\"fixed\" aria-pressed=\"false\">Fixed <b data-draw=\"cnt-fixed\" data-source=\"findings\">\u2014</b></button>\n        <button type=\"button\" class=\"bp-chip\" data-filter=\"all\" aria-pressed=\"true\">All <b data-draw=\"cnt-all\" data-source=\"findings\">\u2014</b></button>\n      </div>\n      <div class=\"bp-scrollbox\">\n        <ul class=\"bp-flist\" data-draw=\"findlist\" data-source=\"findings\"></ul>\n      </div>\n    </section>\n  </div>\n\n  <section class=\"bp-card\" id=\"testpoints\">\n    <h2>Physical test points</h2>\n    <p class=\"bp-note\">Probe points for bring-up: planned, then placed in the schematic, then measured on the real board.</p>\n    <div class=\"bp-scroll\">\n      <table class=\"bp-table\" data-source=\"testpoints\" data-row-key=\"tp\">\n        <thead><tr><th data-field=\"tp\">TP</th><th data-field=\"net\">Net</th><th data-field=\"expected\">Expected</th><th data-field=\"status\">Status</th></tr></thead>\n        <tbody data-draw=\"tprows\"></tbody>\n      </table>\n    </div>\n  </section>\n</div>\n\n<script>\n  const STATUS_LABEL = { not_started: 'Not started', in_progress: 'Executor working', in_review: 'Verifier reviewing', needs_fix: 'Needs fix', verified: 'Verified', planned: 'Planned', in_schematic: 'In schematic', measured_ok: 'Measured OK', failed: 'Failed', open: 'Open', carried: 'Carried', fixed: 'Fixed' };\n  const el = (tag, cls, text) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; };\n  const fmtTime = (s) => { const d = new Date(s); return isNaN(d) ? String(s) : d3.utcFormat('%b %-d %H:%M')(d); };\n\n  dash.calc('progress', {\n    inputs: ['phases'],\n    title: 'Gate progress',\n    description: 'Counts verified phases and names the first phase not yet verified.',\n    fn: (phases) => {\n      const verified = phases.filter((p) => p.status === 'verified').length;\n      const cur = phases.find((p) => p.status !== 'verified');\n      return [{ verified, total: phases.length, current: cur ? `phase ${cur.phase}, ${cur.name.toLowerCase()}` : 'bring-up handoff' }];\n    },\n  });\n\n  dash.calc('now', {\n    inputs: ['phases'],\n    title: 'Current phase',\n    description: 'The first phase not yet verified, with its goal, outputs, gate and round.',\n    fn: (phases) => {\n      const p = phases.find((x) => x.status !== 'verified') || phases[phases.length - 1];\n      return [{ phase: p.phase, title: `Phase ${p.phase} of ${phases.length}: ${p.name}`, goal: p.goal || '', outputs: p.outputs || '', gate_text: p.gate_text || '', rounds: p.rounds, status: p.status, step: p.step || p.status }];\n    },\n  });\n\n  for (const f of ['verified', 'total', 'current']) {\n    dash.draw(f, (e) => { const d = dash.data('progress'); e.textContent = d.status === 'ok' && d.data.length ? String(d.data[0][f]) : '\u2014'; });\n  }\n\n  const nowRow = () => { const d = dash.data('now'); return d.status === 'ok' && d.data.length ? d.data[0] : null; };\n  for (const [name, f] of [['nowname', 'title'], ['nowgoal', 'goal'], ['nowout', 'outputs'], ['nowgate', 'gate_text'], ['nowround', 'rounds']]) {\n    dash.draw(name, (e) => { const r = nowRow(); e.textContent = r ? String(r[f]) : '\u2014'; });\n  }\n  dash.draw('nowstep', (e) => { const r = nowRow(); e.textContent = r ? r.step : '\u2014'; e.className = `bp-pill ${r ? r.status : ''}`; });\n\n  const feedItem = (x, showPhase) => {\n    const li = el('li');\n    li.append(el('span', 'bp-when', fmtTime(x.at)));\n    const w = el('div', 'bp-what');\n    const ev = el('span', `bp-ev ${String(x.event).toLowerCase()}`, x.event + ' ');\n    ev.append(el('span', 'bp-who', `\u00b7 ${x.actor}${showPhase ? ` \u00b7 phase ${x.phase}` : ''} \u00b7 round ${x.round}`));\n    w.append(ev, el('span', 'bp-clamp', x.detail));\n    li.append(w);\n    return li;\n  };\n\n  dash.draw('nowfeed', (ol) => {\n    ol.replaceChildren();\n    const r = nowRow(), a = dash.data('activity');\n    if (!r || a.status !== 'ok') return;\n    a.data.filter((x) => Number(x.phase) === Number(r.phase)).sort((x, y) => Number(y.seq) - Number(x.seq)).slice(0, 3).forEach((x) => ol.append(feedItem(x, false)));\n  });\n\n  dash.draw('actlist', (ol) => {\n    ol.replaceChildren();\n    const a = dash.data('activity');\n    if (a.status !== 'ok') return;\n    [...a.data].sort((x, y) => Number(y.seq) - Number(x.seq)).forEach((x) => ol.append(feedItem(x, true)));\n  });\n\n  const findItem = (x) => {\n    const li = el('li');\n    const d = el('details', 'bp-find');\n    const s = el('summary');\n    const top = el('div', 'bp-find-top');\n    top.append(el('span', `bp-sev ${x.severity}`, x.severity), el('span', 'bp-tag', `${x.id}${x.block ? ' \u00b7 ' + x.block : ''}`), el('span', `bp-pill ${x.status}`, STATUS_LABEL[x.status] || x.status));\n    s.append(top, el('span', 'bp-clamp', x.issue));\n    const fix = el('div', 'bp-find-fix');\n    fix.append(el('b', null, 'Fix'), el('span', null, x.fix));\n    d.append(s, fix);\n    li.append(d);\n    return li;\n  };\n\n  const openFindings = () => {\n    const r = nowRow(), f = dash.data('findings');\n    if (!r || f.status !== 'ok') return null;\n    return f.data.filter((x) => Number(x.phase) === Number(r.phase) && x.status === 'open');\n  };\n  dash.draw('nowfind', (ul) => { ul.replaceChildren(); (openFindings() || []).forEach((x) => ul.append(findItem(x))); });\n  dash.onData(() => {\n    const open = openFindings();\n    document.querySelectorAll('.bp-nofind').forEach((p) => { p.hidden = !(open && open.length === 0); });\n  });\n\n  window.bpFilter = 'all';\n  const counts = () => { const f = dash.data('findings'); if (f.status !== 'ok') return null; const c = { all: f.data.length, open: 0, carried: 0, fixed: 0 }; f.data.forEach((x) => { c[x.status] = (c[x.status] || 0) + 1; }); return c; };\n  for (const k of ['open', 'carried', 'fixed', 'all']) dash.draw(`cnt-${k}`, (e) => { const c = counts(); e.textContent = c ? String(c[k] || 0) : '\u2014'; });\n  document.querySelectorAll('.bp-chip').forEach((b) => b.addEventListener('click', () => {\n    window.bpFilter = b.dataset.filter;\n    document.querySelectorAll('.bp-chip').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));\n    dash.draw('findlist');\n  }));\n  dash.draw('findlist', (ul) => {\n    ul.replaceChildren();\n    const f = dash.data('findings');\n    if (f.status !== 'ok') return;\n    const order = { open: 0, carried: 1, fixed: 2 }, sev = { blocker: 0, major: 1, minor: 2 };\n    f.data.filter((x) => window.bpFilter === 'all' || x.status === window.bpFilter)\n      .sort((x, y) => (order[x.status] ?? 3) - (order[y.status] ?? 3) || Number(y.phase) - Number(x.phase) || (sev[x.severity] ?? 3) - (sev[y.severity] ?? 3))\n      .forEach((x) => ul.append(findItem(x)));\n    if (!ul.children.length) ul.append(el('li', 'bp-empty', 'Nothing in this group.'));\n  });\n\n  dash.draw('steps', (ol) => {\n    ol.replaceChildren();\n    const d = dash.data('phases');\n    if (d.status !== 'ok') return;\n    const cur = d.data.find((p) => p.status !== 'verified');\n    for (const p of d.data) {\n      const li = el('li', `bp-step ${p.status}${cur && p.phase === cur.phase ? ' current' : ''}`);\n      li.append(el('span', 'bp-step-n', `${p.phase} \u00b7 ${p.gate}`), el('span', 'bp-step-name', p.name), el('span', `bp-pill ${p.status}`, STATUS_LABEL[p.status] || p.status));\n      li.append(el('span', 'bp-step-meta', Number(p.rounds) ? `${p.rounds} round${Number(p.rounds) > 1 ? 's' : ''}` : 'Not run yet'));\n      ol.append(li);\n    }\n  });\n\n  // Block positions on a 640 \u00d7 420 board drawing (layout, not data).\n  const LAYOUT = {\n    usbc: [30, 40, 110, 70], prot: [160, 40, 120, 55], pmu: [300, 40, 150, 55], eth: [470, 40, 140, 80],\n    onoff: [30, 125, 110, 60], soc: [170, 120, 250, 190], usb: [470, 135, 140, 60],\n    uart: [30, 200, 110, 60], xtal: [440, 210, 80, 50], nand: [530, 210, 80, 50],\n    sd: [440, 275, 170, 45], gpio: [30, 335, 410, 50], ui: [460, 335, 150, 50],\n  };\n  const TRACES = [['usbc', 'prot'], ['prot', 'pmu'], ['onoff', 'pmu'], ['pmu', 'soc'], ['soc', 'eth'], ['soc', 'usb'], ['soc', 'uart'], ['soc', 'xtal'], ['soc', 'nand'], ['soc', 'sd'], ['soc', 'gpio'], ['soc', 'ui'], ['onoff', 'soc']];\n  const ctr = (id) => { const [x, y, w, h] = LAYOUT[id]; return [x + w / 2, y + h / 2]; };\n\n  dash.draw('board', (host) => {\n    const d = dash.data('blocks');\n    if (d.status !== 'ok') { host.textContent = '\u2014'; return; }\n    host.textContent = '';\n    const byId = new Map(d.data.map((r) => [r.id, r]));\n    const svg = d3.select(host).append('svg').attr('viewBox', '0 0 640 420').attr('width', '100%').attr('role', 'img').attr('aria-label', 'Board block diagram colored by design status');\n    svg.append('rect').attr('class', 'bp-pcb').attr('x', 10).attr('y', 10).attr('width', 620).attr('height', 400).attr('rx', 18);\n    for (const [cx, cy] of [[28, 28], [612, 28], [28, 392], [612, 392]]) svg.append('circle').attr('class', 'bp-hole').attr('cx', cx).attr('cy', cy).attr('r', 6);\n    svg.append('g').selectAll('path').data(TRACES).join('path').attr('class', 'bp-trace')\n      .attr('d', ([a, b]) => { const [x1, y1] = ctr(a), [x2, y2] = ctr(b); return `M${x1},${y1} L${x2},${y1} L${x2},${y2}`; });\n    const tip = d3.select(host).append('div').attr('class', 'bp-tip').attr('hidden', true);\n    const g = svg.append('g').selectAll('g').data(Object.keys(LAYOUT).filter((id) => byId.has(id))).join('g')\n      .attr('class', (id) => `bp-blk st-${byId.get(id).status}`)\n      .attr('transform', (id) => `translate(${LAYOUT[id][0]},${LAYOUT[id][1]})`)\n      .attr('tabindex', 0);\n    g.append('rect').attr('width', (id) => LAYOUT[id][2]).attr('height', (id) => LAYOUT[id][3]).attr('rx', 6);\n    g.append('text').attr('x', 8).attr('y', 18).attr('font-size', (id) => id === 'soc' ? 15 : 11).attr('font-weight', 500).text((id) => byId.get(id).name);\n    g.append('text').attr('class', 'bp-bsub').attr('x', 8).attr('y', (id) => id === 'soc' ? 36 : 32).text((id) => STATUS_LABEL[byId.get(id).status] || byId.get(id).status);\n    g.filter((id) => id === 'soc').append('text').attr('class', 'bp-bsub').attr('x', 8).attr('y', 54).text('Cortex-A7 \u00b7 256 MB DDR3L \u00b7 QFN-128');\n    const show = (ev, id) => {\n      const r = byId.get(id), box = host.getBoundingClientRect(), [x, y, w, h] = LAYOUT[id], s = box.width / 640;\n      tip.attr('hidden', null).html('');\n      tip.append('div').attr('class', 'bp-tip-k').text(`${r.name} \u00b7 ${r.req}${r.phase ? ' \u00b7 ' + r.phase : ''}`);\n      tip.append('div').text(r.note || '');\n      const tw = tip.node().offsetWidth, th = tip.node().offsetHeight;\n      const top = y * s - th - 6 < 0 ? (y + h) * s + 6 : y * s - th - 6;\n      tip.style('left', `${Math.max(0, Math.min(box.width - tw, (x + w / 2) * s - tw / 2))}px`).style('top', `${top}px`);\n    };\n    g.on('mouseenter focus', show).on('mouseleave blur', () => tip.attr('hidden', true));\n  });\n\n  dash.draw('tprows', (tb) => {\n    const d = dash.data('testpoints');\n    tb.replaceChildren();\n    if (d.status !== 'ok') return;\n    for (const r of d.data) {\n      const tr = tb.insertRow();\n      tr.insertCell().textContent = r.tp;\n      tr.insertCell().textContent = r.net;\n      tr.insertCell().textContent = r.expected;\n      tr.insertCell().append(el('span', `bp-pill ${r.status}`, STATUS_LABEL[r.status] || r.status));\n    }\n  });\n</script>\n"}
r-clear lens design, making it ideal for low-power indicator applications. Refer to the datasheet for detailed electrical and optical parameters."}],"pdfUrl":"https://datasheet.lcsc.com/datasheet/pdf/6b7293b42c3b9e043993e4b0f98f47bf.pdf?productCode=C965804","authenticationList":["ROHS 认证"],"isRohsCert":true,"rohsCertType":"ROHS","rohsCertList":[{"fileCode":"wj1522579","fileName":"0603红_ROHS认证(中文版)_XINGLIGHT(成兴光).pdf","url":"https://datasheet.lcsc.com/certification/rohs/08ce3c474abdc22bbc0b074e5bdacece.pdf"},{"fileCode":"wj1668319","fileName":"贴片发光二极管如文件列表_RoHS认证(英文版)_XINGLIGHT(成兴光).pdf","url":"https://datasheet.lcsc.com/certification/rohs/d196c2d2993e4efbfca4b676ed52eca8.pdf"}],"productDescEn":"Emerald Green 525nm LED Indication - Discrete 3.3V 0603","productIntroEn":"Emerald Green 525nm LED Indication - Discrete 3.3V 0603","paramVOList":[{"paramCode":"param_30453","paramName":"载带方式","paramNameEn":"Installation method","paramValue":"正贴","paramValueEn":"Top-mount","paramValueEnForSearch":-1.0,"isMain":false,"sortNumber":1,"sort":9},{"paramCode":"param_13418_s","paramName":"色温","paramNameEn":"Color Temperature","paramValue":"-","paramValueEn":"-","paramValueEnForSearch":null,"isMain":true,"sortNumber":1,"sort":38},{"paramCode":"param_13783_n","paramName":"峰值波长","paramNameEn":"Peak Wavelength","paramValue":"525nm","paramValueEn":"525nm","paramValueEnForSearch":null,"isMain":true,"sortNumber":1,"sort":3},{"paramCode":"param_30451","paramName":"透镜颜色","paramNameEn":"Lens Color","paramValue":"无色透明透镜","paramValueEn":"Water Clear","paramValueEnForSearch":-1.0,"isMain":false,"sortNumber":1,"sort":7},{"paramCode":"param_13422_s","paramName":"发光强度","paramNameEn":"Luminous Intensity","paramValue":"810mcd","paramValueEn":"810mcd","paramValueEnForSearch":null,"isMain":true,"sortNumber":1,"sort":54},{"paramCode":"param_13787","paramName":"接收角度","paramNameEn":"Viewing Angle","paramValue":"120°","paramValueEn":"120°","paramValueEnForSearch":-1.0,"isMain":true,"sortNumber":1,"sort":2}
# Kernel config fragment for the RV1106G3 custom board, Rev A (D-93, D-98).
# Merged after luckfox_rv1106_linux_defconfig through RK_KERNEL_DEFCONFIG_FRAGMENT
# ("make luckfox_rv1106_linux_defconfig custom-reva.config", sysdrv/Makefile L490).
# Already =y in the Luckfox defconfig and listed here only so the board does not depend on it:
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_ADC=y
CONFIG_GPIO_SYSFS=y
CONFIG_POWER_RESET=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
# New for this board:
# R4 -- PWR_KILL (GPIO0_A4) as the last step of poweroff (drivers/power/reset/gpio-poweroff.c)
CONFIG_POWER_RESET_GPIO=y
# Status LED heartbeat and Ethernet activity LED
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_NETDEV=y
